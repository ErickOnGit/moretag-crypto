{
  "name": "moretag-crypto",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/ratchet/file-store.d.ts",
      "import": "./dist/ratchet/file-store.js",
      "default": "./dist/ratchet/file-store.js"
    },
    "./providers/node-crypto": {
      "types": "./dist/providers/node-crypto.d.ts",
      "import": "./dist/providers/node-crypto.js",
      "default": "./dist/providers/node-crypto.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "crypto",
    "x3dh",
    "e2ee",
    "encryption",
    "x25519",
    "ed25519",
    "xchacha20poly1305"
  ],
  "author": "",
  "license": "Apache-2.0",
  "description": "TypeScript cryptographic library for end-to-end encrypted messaging with X3DH key agreement",
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "cbor-x": "^1.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
